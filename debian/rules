#!/usr/bin/make -f

# 净室打包:强制 nodoc(等价 DEB_BUILD_PROFILES=nodoc),保证 dpkg-buildpackage -b -us -uc 裸命令可用
DEB_BUILD_PROFILES := $(filter-out nodoc,$(DEB_BUILD_PROFILES)) nodoc
export DEB_BUILD_PROFILES

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_install:
	dh_install
	# do not install the license-file into an arch-dependent location
	rm -rf $(CURDIR)/debian/qt6-translations-l10n/usr/lib/
